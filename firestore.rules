rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return me().role; }
    function isAdmin() { return signedIn() && role() == 'Admin'; }
    function isReviewer() { return signedIn() && role() in ['Reviewer', 'Admin']; }
    function workspaceExists() { return exists(/databases/$(database)/documents/brand/rules); }

    // ---------- Users ----------
    // Everyone signed in can read profiles (names for the audit trail).
    // A new account is a Creator. The very first account, created while no workspace exists yet,
    // becomes the workspace Admin. After that, ONLY an Admin can change anybody's role.
    // People can edit their own name and photo, never their own role or email.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.role == 'Creator'
          || (request.resource.data.role == 'Admin' && !workspaceExists()));
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['Creator', 'Reviewer', 'Admin'])
      );
      allow delete: if false;
    }

    // ---------- Brand rules ----------
    // Anyone signed in can read. Only an Admin can create or change the brand pack.
    // No secrets are stored here: the Gemini key lives on the server (Vercel env var).
    match /brand/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- Documents ----------
    // A creator reads and writes their own documents. Reviewers and Admins read all.
    // Reviewers/Admins can request changes. Only the server approval endpoint can set Approved,
    // and nobody can approve a document they own (separation of duties).
    // When an owner edits an Approved or Changes-requested document it must go back to Draft.
    match /docs/{docId} {
      allow read: if signedIn() && (resource.data.owner == request.auth.uid || isReviewer());
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.status in ['Draft', 'In review'];
      allow update: if signedIn()
        && request.resource.data.status != 'Approved'
        && request.resource.data.owner == resource.data.owner
        && (
          // owner saving or submitting
          (resource.data.owner == request.auth.uid
            && resource.data.status in ['Draft', 'Changes requested', 'Approved']
            && request.resource.data.status in ['Draft', 'In review'])
          // A submitted version is immutable to its creator while reviewers inspect it.
          || (resource.data.owner == request.auth.uid
            && resource.data.status == 'In review'
            && request.resource.data.status == 'Draft')
          // Comments and their audit entry are the only same-status creator edits in review.
          || (resource.data.owner == request.auth.uid
            && resource.data.status == 'In review'
            && request.resource.data.status == 'In review'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'audit']))
          // owner re-saving a reviewed document without touching its status is not allowed;
          // the client must reset it to Draft, which the line above permits.
          // reviewer / admin decisions on somebody else's document
          || (isReviewer() && resource.data.owner != request.auth.uid
              && resource.data.status == 'In review'
              && request.resource.data.status in ['Draft', 'In review', 'Changes requested'])
        );
      allow delete: if isAdmin()
        || (signedIn()
          && resource.data.owner == request.auth.uid
          && resource.data.status in ['Draft', 'Changes requested']);
    }

    // ---------- Events ----------
    // Append-only log that powers Insights. Must look like a real event.
    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['ruleId', 'outcome', 'at'])
        && request.resource.data.outcome in ['accepted', 'edited', 'disputed'];
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
